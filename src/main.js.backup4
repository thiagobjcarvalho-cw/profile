                variant="outlined"
                class="mb-4"
              >
                Experiência
              </v-chip>
              
              <h2 class="text-h3 font-weight-bold mb-6" style="position: relative;">
                Trajetória <span class="text-primary">Profissional</span>
                <div style="
                  position: absolute;
                  bottom: -8px;
                  left: 50%;
                  transform: translateX(-50%);
