            @click="toggleTheme"
            class="ml-2"
          ></v-btn>
        </v-container>
      </v-app-bar>

      <v-main>
        <!-- Hero Section -->
        <section id="hero" style="min-height: 100vh; background: linear-gradient(135deg, #0F0F23 0%, #1a1a3a 100%); display: flex; align-items: center;">
          <v-container>
            <v-row align="center">
              <v-col cols="12" md="6">
                <div style="color: white;">
                  <v-chip color="success" variant="outlined" class="mb-4">
                    <v-icon start icon="mdi-circle" size="small"></v-icon>
                    Disponível para projetos
                  </v-chip>
                  
                  <h1 class="text-h2 font-weight-black mb-4">
                    Olá, eu sou<br>
                    <span style="background: linear-gradient(45deg, #60A5FA, #F59E0B); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                      Thiago Carvalho
                    </span>
                  </h1>
                  
                  <h2 class="text-h4 font-weight-light mb-4" style="color: rgba(255,255,255,0.8);">
                    Full Stack Developer Sr.
                  </h2>
                  
                  <p class="text-h6 mb-4" style="color: rgba(255,255,255,0.6);">
                    <v-icon icon="mdi-map-marker" size="small" class="mr-2"></v-icon>
                    Brasília, DF • Full Stack Developer no TCDF
                  </p>
                  
                  <p class="text-body-1 mb-8" style="color: rgba(255,255,255,0.7); max-width: 500px; line-height: 1.7;">
                    Engenheiro de Software com mais de <strong>10 anos de experiência</strong> 
                    sólida em tecnologias de ponta, especializado em desenvolvimento 
                    <strong>Frontend e Full Stack</strong>. Domínio em VueJS, ReactJS, Angular e 
                    API Platform.
                  </p>
                  
                  <div class="d-flex flex-wrap gap-4 mb-6">
                    <v-btn 
                      color="primary" 
                      size="large" 
                      prepend-icon="mdi-briefcase"
                      @click="navigateToSection('experience')"
                    >
                      Ver Experiência
                    </v-btn>
                    
                    <v-btn 
                      variant="outlined" 
                      color="white" 
                      size="large" 
                      prepend-icon="mdi-email"
                      @click="navigateToSection('contact')"
                    >
                      Contato
                    </v-btn>
                  </div>
                  
                  <div class="d-flex gap-2">
                    <v-btn icon="mdi-linkedin" variant="text" color="white" href="https://linkedin.com/in/thiagobjcarvalho" target="_blank"></v-btn>
                    <v-btn icon="mdi-github" variant="text" color="white" href="https://github.com/thiagobjcarvalho-cw" target="_blank"></v-btn>
                    <v-btn icon="mdi-email" variant="text" color="white" href="mailto:thiagob.j.carvalho@gmail.com"></v-btn>
                  </div>
                </div>
              </v-col>
              
              <v-col cols="12" md="6" class="text-center">
                <div style="position: relative; display: inline-block;">
                  <v-avatar size="280" style="border: 4px solid rgba(59, 130, 246, 0.3); animation: float 6s ease-in-out infinite;">
                    <div style="background: linear-gradient(135deg, #3B82F6, #2563EB); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 8rem; color: white;">
                      TC
                    </div>
                  </v-avatar>
                  
                  <!-- Skills flutuantes -->
                  <v-chip 
                    v-for="(skill, i) in ['VueJS', 'ReactJS', 'Angular', 'TypeScript', 'PHP', 'Laravel', 'API Platform', 'Full Stack']"
                    :key="skill"
                    :style="{
                      position: 'absolute',
                      top: (Math.sin(i * Math.PI / 4) * 150 + 150) + 'px',
                      left: (Math.cos(i * Math.PI / 4) * 150 + 150) + 'px',
                      transform: 'translate(-50%, -50%)',
                      animation: \`float-skill \${3 + i * 0.2}s ease-in-out infinite\`
                    }"
                    color="white"
                    variant="elevated"
                    size="small"
                  >
                    {{ skill }}
                  </v-chip>
                </div>
              </v-col>
            </v-row>
          </v-container>
        </section>

        <!-- About Section -->
        <section id="about" class="py-16">
          <v-container>
            <div class="text-center mb-12">
              <h2 class="text-h3 font-weight-bold mb-4">
                Sobre <span class="text-primary">Mim</span>
              </h2>
            </div>
            
            <v-row>
              <v-col cols="12" md="8">
                <v-card class="pa-8 mb-6" elevation="2">
                  <h3 class="text-h5 font-weight-bold mb-4">Thiago Carvalho</h3>
                  <p class="text-body-1 mb-4">
                    Como <strong>Full Stack Developer</strong> no Tribunal de Contas do Distrito Federal (TCDF), 
                    atuo no desenvolvimento especializado em <strong>VueJS, API Platform e Vuetify</strong>, 
                    criando aplicações robustas e escaláveis para o setor público.
                  </p>
                </v-card>

                <v-row class="mb-6">
                  <v-col v-for="stat in [
                    {value: '10+', label: 'Anos Experiência', icon: 'mdi-calendar', color: 'primary'},
                    {value: '50+', label: 'Projetos', icon: 'mdi-rocket', color: 'success'},
                    {value: '15+', label: 'Tecnologias', icon: 'mdi-code-tags', color: 'info'},
                    {value: '100%', label: 'Dedicação', icon: 'mdi-heart', color: 'error'}
                  ]" :key="stat.label" cols="6" md="3">
                    <v-card :color="stat.color" class="text-center pa-4 text-white">
                      <v-icon :icon="stat.icon" size="32" class="mb-2"></v-icon>
                      <div class="text-h4 font-weight-bold">{{ stat.value }}</div>
                      <div class="text-caption">{{ stat.label }}</div>
                    </v-card>
                  </v-col>
                </v-row>
              </v-col>
              
              <v-col cols="12" md="4">
                <v-card class="pa-6" elevation="2">
                  <h4 class="text-h6 font-weight-bold mb-4">
                    <v-icon icon="mdi-school" class="mr-2"></v-icon>
                    Formação
                  </h4>
                  
                  <div class="mb-4">
                    <h5 class="font-weight-bold">Tecnólogo em Análise e Desenvolvimento</h5>
                    <p class="text-primary">Grupo Projeção</p>
                    <p class="text-caption">2008 - 2011</p>
                  </div>
                </v-card>
              </v-col>
            </v-row>
          </v-container>
        </section>

        <!-- Experience Section -->
        <section id="experience" style="background: #f8f9fa;" class="py-16">
          <v-container>
            <div class="text-center mb-12">
              <h2 class="text-h3 font-weight-bold">Experiência <span class="text-primary">Profissional</span></h2>
            </div>
            
            <v-timeline>
              <v-timeline-item
                v-for="exp in [
                  {
                    period: 'Jul/2024 - Atual',
                    role: 'Full Stack Developer',
                    company: 'TCDF',
                    description: 'Desenvolvimento Full Stack com VueJS, API Platform e Vuetify',
                    color: 'primary'
                  },
                  {
                    period: 'Fev/2023 - Fev/2024', 
                    role: 'Analista Desenvolvimento Sênior',
                    company: 'Fretebras',
                    description: 'Sistema de gestão de fretes e logística',
                    color: 'success'
                  },
                  {
                    period: 'Jan/2022 - Out/2022',
                    role: 'Analista Desenvolvedor Sr',
                    company: 'SysMap Solutions',
                    description: 'ReactJS para Editora FTD e Renner',
                    color: 'info'
                  }
                ]"
                :key="exp.period"
                :dot-color="exp.color"
                size="small"
              >
                <v-card>
                  <v-card-title>{{ exp.role }}</v-card-title>
                  <v-card-subtitle>{{ exp.company }} • {{ exp.period }}</v-card-subtitle>
                  <v-card-text>{{ exp.description }}</v-card-text>
                </v-card>
              </v-timeline-item>
            </v-timeline>
          </v-container>
        </section>

        <!-- Skills Section -->
        <section id="skills" class="py-16">
          <v-container>
            <div class="text-center mb-12">
              <h2 class="text-h3 font-weight-bold">Competências <span class="text-primary">Técnicas</span></h2>
            </div>
            
            <v-row>
              <v-col v-for="category in [
                {
                  title: 'Frontend',
                  icon: 'mdi-vuejs',
                  color: 'primary',
                  skills: ['VueJS (Vue 2 & 3)', 'ReactJS', 'Angular', 'TypeScript', 'Vuetify']
                },
                {
                  title: 'Backend',
                  icon: 'mdi-server',
                  color: 'success',
                  skills: ['PHP/Laravel', 'API Platform', 'Symfony', 'Node.js', 'RESTful APIs']
                },
                {
                  title: 'Database',
                  icon: 'mdi-database',
                  color: 'info',
                  skills: ['PostgreSQL', 'MySQL', 'Oracle', 'MongoDB']
                },
                {
                  title: 'DevOps',
                  icon: 'mdi-tools',
                  color: 'warning',
                  skills: ['Docker', 'Git', 'CI/CD', 'Linux']
                }
              ]" :key="category.title" cols="12" md="6" lg="3">
                <v-card class="pa-6 h-100" elevation="2">
                  <div class="d-flex align-center mb-4">
                    <v-avatar :color="category.color" size="40" class="mr-3">
                      <v-icon :icon="category.icon" color="white"></v-icon>
                    </v-avatar>
                    <h4 class="text-h6 font-weight-bold">{{ category.title }}</h4>
                  </div>
                  
                  <v-list density="compact">
                    <v-list-item v-for="skill in category.skills" :key="skill">
                      <template v-slot:prepend>
                        <v-icon icon="mdi-check" :color="category.color" size="small"></v-icon>
                      </template>
                      <v-list-item-title class="text-body-2">{{ skill }}</v-list-item-title>
                    </v-list-item>
                  </v-list>
                </v-card>
              </v-col>
            </v-row>
          </v-container>
        </section>

        <!-- Contact Section -->
        <section id="contact" style="background: linear-gradient(135deg, #0F0F23 0%, #1a1a3a 100%);" class="py-16">
          <v-container>
            <div class="text-center">
              <v-card class="pa-12 mx-auto" max-width="600" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(10px);">
                <h2 class="text-h3 font-weight-bold mb-6 text-white">
                  Vamos trabalhar juntos?
                </h2>
                
                <p class="text-h6 mb-8 text-white" style="opacity: 0.8;">
                  Sempre aberto para discussões sobre tecnologia e novos projetos
                </p>
                
                <div class="d-flex justify-center flex-wrap gap-4">
                  <v-btn 
                    v-for="contact in [
                      {icon: 'mdi-email', text: 'Email', href: 'mailto:thiagob.j.carvalho@gmail.com'},
                      {icon: 'mdi-linkedin', text: 'LinkedIn', href: 'https://linkedin.com/in/thiagobjcarvalho'},
                      {icon: 'mdi-github', text: 'GitHub', href: 'https://github.com/thiagobjcarvalho-cw'},
                      {icon: 'mdi-whatsapp', text: 'WhatsApp', href: 'https://wa.me/5561982859870'}
                    ]"
                    :key="contact.text"
