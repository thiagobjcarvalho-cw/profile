      <!-- Footer -->
      <v-footer class="pa-6" style="background: #0F0F23; color: white;">
        <v-container>
          <div class="text-center">
            <p>&copy; 2024 Thiago Carvalho. Desenvolvido com Vue.js + Vuetify</p>
            <p class="text-caption mt-2">Full Stack Developer • 10+ anos de experiência</p>
          </div>
        </v-container>
      </v-footer>
